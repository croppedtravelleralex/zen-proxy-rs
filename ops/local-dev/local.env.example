# Copy to ops/local-dev/local.env and adjust paths if needed.
# Source: bash ops/local-dev/run-local-zenproxy.sh

BIND_ADDRESS=127.0.0.1
PORT=14000

NODES_FILE=/home/lenovo/zen-free-model-suite/.local-dev/nodes-prod.json
UPSTREAM_BASE=https://opencode.ai/zen
UPSTREAM_API_KEY=public
ADMIN_API_KEY=local-dev-admin
PROXY_API_KEY=local-dev-proxy
ALLOW_DIRECT_FALLBACK=false

ZEN_PROVIDER_MODE=free_model_kernel
V4_MODEL_REGISTRY_ENABLED=true
AUDIT_LOG_ENABLED=true
AUDIT_LOG_DIR=/home/lenovo/zen-free-model-suite/.local-dev/audit
LEDGER_EVENTS_PATH=/home/lenovo/zen-free-model-suite/.local-dev/ledger-events.jsonl

# CCP cache control plane (match production)
CCP_ICP_ENABLED=1
CCP_PROMPT_CACHE_KEY=1
CCP_REASONING_SIDECAR=1
CCP_TRF_STRICT=1
CCP_ANTHROPIC_BP=1

# Optional Redis for session pin (memory fallback if unset)
# GLOBAL_BUDGET_REDIS_URL=redis://127.0.0.1:6379/2
# CCP_SESSION_PIN_REDIS_URL=redis://127.0.0.1:6379/2

REQUEST_TIMEOUT_SECS=300
CONNECT_TIMEOUT_SECS=15
REQUEST_BODY_LIMIT_MB=64
LOG_LEVEL=info

# Lanes (lighter than production for local)
V43_LANES_ENABLED=true
V43_STREAM_CONCURRENCY=32
V43_LARGE_CONTEXT_CONCURRENCY=8
V43_HUGE_CONTEXT_CONCURRENCY=2

DYNAMIC_MODEL_DISCOVERY_ENABLED=false
DYNAMIC_MODEL_PROBE_ENABLED=false

# Match production behavior
OPENCODE_HEADERS_ENABLED=true
ZEN_COMPACTOR_MODE=observe
FREE_MODEL_TRUE_FIRST_TOKEN_FRT=true
V4_EMPTY_UPSTREAM_MAX_RETRIES=12
V4_RETRY_BUDGET_MS=240000
POOL_MAX_RETRIES=3
NODE_MAX_CALLS_PER_WINDOW=300
NODE_MAX_TOKENS_PER_WINDOW=30000000
NODE_BUDGET_WINDOW_SECS=900
